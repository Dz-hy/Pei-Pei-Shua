<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="时政 AI 模型配置"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="时政新闻的精选、分类、出题使用此独立模型，与主体 AI（悬浮球解析）互不影响"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.3" />

    <!-- 从已有模型导入 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="从已配置的模型导入"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <Spinner
        android:id="@+id/spinner_import"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_question_box" />

    <!-- API 地址 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="API 地址"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_base_url"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_question_box"
        android:paddingHorizontal="10dp"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:hint="如 https://api.deepseek.com"
        android:inputType="textUri"
        android:maxLines="1" />

    <!-- API Key -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="API Key"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_api_key"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_question_box"
        android:paddingHorizontal="10dp"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:hint="sk-..."
        android:inputType="textPassword"
        android:maxLines="1" />

    <!-- 模型名称 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="模型名称"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_model"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_question_box"
        android:paddingHorizontal="10dp"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:hint="如 deepseek-chat"
        android:inputType="text"
        android:maxLines="1" />

    <!-- 协议类型 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="接口协议"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <Spinner
        android:id="@+id/spinner_api_type"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_question_box" />
</LinearLayout>
