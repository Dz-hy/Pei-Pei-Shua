<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="答题卡"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tv_card_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="已答 0/0 题"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#EEEEEE" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_card_balls"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never" />

    <!-- 图例 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_ball_unanswered" />

        <TextView
            android:id="@+id/tv_legend_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:text="未答"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <View
            android:id="@+id/legend_dot_2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_ball_answered" />

        <TextView
            android:id="@+id/tv_legend_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:text="已答"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <View
            android:id="@+id/legend_dot_3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_ball_wrong"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_legend_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:text="答错"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <View
            android:id="@+id/legend_dot_4"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_ball_correct"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_legend_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="答对"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_card_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_card_restart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_weight="1"
            android:text="再来一组"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_card_exit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_weight="1"
            android:text="退出训练"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
