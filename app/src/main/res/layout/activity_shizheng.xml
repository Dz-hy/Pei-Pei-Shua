<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- ===== Header Title Bar ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/background"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="时政热点"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_toStartOf="@id/btn_refresh"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_settings"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_refresh"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/primary" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <!-- ===== 同步状态 ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/background_card_glass">

        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="共 0 道时政题 · 打开应用时自动抓取求是网与中国组织人事报"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.3" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== 搜索框（标题+正文，本地 LIKE，300ms 防抖） ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/background_card_glass">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/text_tertiary" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索标题、内容或日期"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_tertiary"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== 来源筛选（求是 / 组织人事报分开浏览） ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/chip_src_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部来源"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="7dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_primary_chip"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_src_qiushi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="求是"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="7dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_default_chip"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_src_org"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="组织人事报"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="7dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_default_chip"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== 思想体系筛选 ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="7dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_primary_chip"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_ten"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="十个明确"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="7dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_default_chip"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_fourteen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="十四个坚持"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="7dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_default_chip"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_thirteen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="十三个方面成就"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="7dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_default_chip"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_six"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="六个必须坚持"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="7dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_default_chip"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== 新闻列表 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_news"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📰"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tv_empty_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="暂无时政新闻\n点击右上角刷新抓取"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== 底部操作 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/btn_practice"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="开始练习"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_primary_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_wrong"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:text="错题回顾"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_outline_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
