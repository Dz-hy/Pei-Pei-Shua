<?xml version="1.0" encoding="utf-8"?><!--
   数据提取规则（API 31+）：与 backup_rules.xml 口径一致——
   SharedPreferences 内含明文 API Key，云备份与设备迁移均排除。
   详见 https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
